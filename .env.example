# Скопируйте в .env: cp .env.example .env

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
# Через запятую. Пусто — CORS выключен (UI отдаётся тем же сервером).
HTTP_CORS_ALLOWED_ORIGINS=
# Swagger на публичном адресе. На локальном (AUTH_LOCAL_ADDR) включён всегда.
HTTP_SWAGGER_ENABLED=false

POSTGRES_USER=todoapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=todoapp
POSTGRES_TIMEOUT=10s
POSTGRES_SSLMODE=disable
# Необязательно: POSTGRES_MAX_CONNS, POSTGRES_MIN_CONNS,
# POSTGRES_MAX_CONN_LIFETIME, POSTGRES_MAX_CONN_IDLE_TIME

LOGGER_LEVEL=DEBUG

# Токен бота от @BotFather. Без него вход через Telegram не работает.
AUTH_TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылок-приглашений в общие списки (t.me/<бот>?startapp=...).
AUTH_TELEGRAM_BOT_USERNAME=
# Адрес Bot API. Менять только для проверки с заглушкой.
# AUTH_TELEGRAM_API_URL=https://api.telegram.org
# Сколько живёт initData после открытия мини-аппа.
AUTH_INIT_DATA_MAX_AGE=24h
# Telegram id администраторов через запятую (свой id можно узнать у @userinfobot).
AUTH_ADMIN_TELEGRAM_IDS=
# Ваш Telegram id: на локальном адресе вы работаете от его имени с правами
# администратора. Адрес задаётся в docker-compose (:5051) и в make todoapp-run.
AUTH_LOCAL_TELEGRAM_ID=

# --- Только на сервере (см. README, раздел «Сервер») ---
# Подключает Caddy с HTTPS из docker-compose.prod.yaml.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.prod.yaml
# Адрес мини-аппа: IP сервера через дефисы + .sslip.io, например 1-2-3-4.sslip.io.
# APP_DOMAIN=
