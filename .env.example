# Скопируйте в .env: cp .env.example .env

HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
# Через запятую. Пусто — CORS выключен (UI отдаётся тем же сервером).
HTTP_CORS_ALLOWED_ORIGINS=
HTTP_SWAGGER_ENABLED=true

POSTGRES_USER=todoapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=todoapp
POSTGRES_TIMEOUT=10s
POSTGRES_SSLMODE=disable
# Необязательно: POSTGRES_MAX_CONNS, POSTGRES_MIN_CONNS,
# POSTGRES_MAX_CONN_LIFETIME, POSTGRES_MAX_CONN_IDLE_TIME

LOGGER_LEVEL=DEBUG
